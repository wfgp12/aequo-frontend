# Configuración de la app web de Firebase (proyecto aequo-finance).
# Copiar este archivo a .env y completar los valores. El .env no se versiona.
# Se obtienen en Firebase Console > Configuración del proyecto > General > Tus apps > App web > Configuración del SDK.
# Llevan prefijo EXPO_PUBLIC_ porque Expo las incluye en el bundle: son identificadores públicos de la app, no secretos.
# Reiniciar el servidor de Expo después de cambiarlas.
#
# Del objeto firebaseConfig solo se copian estos cuatro valores; storageBucket, messagingSenderId y measurementId no se usan.

# firebaseConfig.apiKey. Empieza por "AIza".
EXPO_PUBLIC_FIREBASE_API_KEY=

# firebaseConfig.authDomain. Con la forma <projectId>.firebaseapp.com. No es la API key.
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=

# firebaseConfig.projectId. Tiene que ser igual a FIREBASE_PROJECT_ID del .env del backend.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# firebaseConfig.appId, el de la app WEB. Tiene la forma 1:<número>:web:<código>.
EXPO_PUBLIC_FIREBASE_APP_ID=

# ID de cliente OAuth de tipo "Web" que Firebase crea al habilitar Google (Google Cloud Console > APIs y servicios > Credenciales).
# Lo necesita el inicio de sesión nativo de Android para pedir el token. Termina en .apps.googleusercontent.com.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# URL base del backend (aequo-backend), sin barra final. Si se omite, la app usa http://localhost:3000.
#   Web:                http://localhost:3000
#   Emulador Android:   http://10.0.2.2:3000
#   iPhone / teléfono:  http://<IP local del PC>:3000
EXPO_PUBLIC_API_URL=
