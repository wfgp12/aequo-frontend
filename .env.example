# Configuración de la app web de Firebase.
# Se obtiene en Firebase Console > Configuración del proyecto > General > Tus apps > App web > Configuración del SDK.
# Copiar este archivo a .env y completar los valores. El .env no se versiona.
# Estos valores van dentro del bundle (prefijo EXPO_PUBLIC_): son identificadores públicos de la app, no secretos.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
