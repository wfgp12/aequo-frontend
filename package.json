{
  "name": "aequo-frontend",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "start:dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint -- --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:mutacion": "stryker run",
    "format": "prettier --write \"{app,components,lib,__tests__}/**/*.{ts,tsx}\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2
  },
  "dependencies": {
    "@react-native-google-signin/google-signin": "16.1.5",
    "@rn-primitives/portal": "1.5.3",
    "@rn-primitives/slot": "1.5.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "57.0.30",
    "expo-constants": "57.0.22",
    "expo-dev-client": "57.0.20",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.28",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "firebase": "13.0.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "prettier": "3.9.10",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
