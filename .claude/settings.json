{
  "crossSessionInbound": "accept",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guardia-pruebas.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["../coordinacion"],
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:mutacion)",
      "Bash(npm run lint)",
      "Bash(npx jest *)",
      "Bash(npx stryker run *)",
      "Bash(npx tsc *)",
      "Bash(npx prettier --check *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --merged *)",
      "Bash(git branch -r --merged *)",
      "Bash(git fetch *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npm uninstall *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)"
    ]
  }
}
