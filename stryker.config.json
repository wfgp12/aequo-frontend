{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "checkers": [
    "typescript"
  ],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "lib/**/*.ts",
    "!lib/firebase.ts",
    "!lib/theme.ts",
    "!lib/utils.ts",
    "!lib/dev-session.ts",
    "!lib/**/*.web.ts",
    "!lib/google-sign-in.ts",
    "!lib/session-storage.ts"
  ],
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "thresholds": {
    "high": 80,
    "low": 75,
    "break": 75
  },
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "timeoutMS": 30000,
  "concurrency": 4
}
